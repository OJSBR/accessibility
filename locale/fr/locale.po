msgid "plugins.block.accessibility.displayName"
msgstr "Bloc d'accessibilité (zoom et contraste)"

msgid "plugins.block.accessibility.description"
msgstr "Ajoute un bloc dans la barre latérale avec des commandes pour agrandir, réduire le zoom et activer le contraste élevé pour les lecteurs."

msgid "plugins.block.accessibility.title"
msgstr "Accessibilité"

msgid "plugins.block.accessibility.zoomIn"
msgstr "Augmenter la taille du texte"

msgid "plugins.block.accessibility.zoomOut"
msgstr "Réduire la taille du texte"

msgid "plugins.block.accessibility.contrast"
msgstr "Activer/désactiver le contraste élevé"

msgid "plugins.block.accessibility.reset"
msgstr "Réinitialiser les paramètres d'accessibilité"
