msgid "plugins.block.accessibility.displayName"
msgstr "Blocco di Accessibilità (Zoom e Contrasto)"

msgid "plugins.block.accessibility.description"
msgstr "Aggiunge un blocco nella barra laterale con i controlli per aumentare lo zoom, ridurre lo zoom e attivare l'alto contrasto per i lettori."

msgid "plugins.block.accessibility.title"
msgstr "Accessibilità"

msgid "plugins.block.accessibility.zoomIn"
msgstr "Aumenta la dimensione del testo"

msgid "plugins.block.accessibility.zoomOut"
msgstr "Riduci la dimensione del testo"

msgid "plugins.block.accessibility.contrast"
msgstr "Attiva/disattiva l'alto contrasto"

msgid "plugins.block.accessibility.reset"
msgstr "Reimposta le impostazioni di accessibilità"
