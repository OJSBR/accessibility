msgid "plugins.block.accessibility.displayName"
msgstr "Bloque de Accesibilidad (Zoom y Contraste)"

msgid "plugins.block.accessibility.description"
msgstr "Añade un bloque en la barra lateral con controles para aumentar zoom, reducir zoom y alto contraste para los lectores."

msgid "plugins.block.accessibility.title"
msgstr "Accesibilidad"

msgid "plugins.block.accessibility.zoomIn"
msgstr "Aumentar el tamaño del texto"

msgid "plugins.block.accessibility.zoomOut"
msgstr "Reducir el tamaño del texto"

msgid "plugins.block.accessibility.contrast"
msgstr "Alternar alto contraste"

msgid "plugins.block.accessibility.reset"
msgstr "Restablecer la configuración de accesibilidad"
